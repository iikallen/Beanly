# Copy to production.env with mode 0600. Never reuse these values in staging.
REGISTRY=ghcr.io/iikallen
GIT_SHA=
APP_VERSION=0.1.0
BUILD_TIME=

# Resolve and pin these images by manifest digest before deployment.
PROXY_IMAGE=
OTEL_COLLECTOR_IMAGE=
BEANLY_HOST=beanly.example.com
TLS_CERT_PATH=/etc/beanly/tls/fullchain.pem
TLS_KEY_PATH=/etc/beanly/tls/privkey.pem

POSTGRES_DB=beanly
POSTGRES_USER=beanly
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=

JWT_SECRET=
AUDIT_IP_HASH_SECRET=
INTEGRATION_ENCRYPTION_KEYS=
CORS_ORIGINS=["https://beanly.example.com"]
TRUSTED_HOSTS=["beanly.example.com"]

# Vendor/project dedicated to production telemetry.
OTEL_BACKEND_OTLP_ENDPOINT=
OTEL_BACKEND_AUTH_TOKEN=

# The default pools budget 5 processes x (5 + 5) + 10 admin = 60 of 80.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_PROCESS_COUNT=5
DB_ADMIN_RESERVE=10
DB_CONNECTION_BUDGET=80
