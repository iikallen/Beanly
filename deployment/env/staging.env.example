# Copy to staging.env with mode 0600. Generate every secret independently of production.
REGISTRY=ghcr.io/iikallen
GIT_SHA=
APP_VERSION=0.1.0
BUILD_TIME=

PROXY_IMAGE=
OTEL_COLLECTOR_IMAGE=
STAGING_BEANLY_HOST=staging.beanly.example.com
STAGING_TLS_CERT_PATH=/etc/beanly-staging/tls/fullchain.pem
STAGING_TLS_KEY_PATH=/etc/beanly-staging/tls/privkey.pem

STAGING_POSTGRES_DB=beanly_staging
STAGING_POSTGRES_USER=beanly_staging
STAGING_POSTGRES_PASSWORD=
STAGING_DATABASE_URL=
STAGING_REDIS_PASSWORD=
STAGING_REDIS_URL=
STAGING_CELERY_BROKER_URL=

STAGING_JWT_SECRET=
STAGING_AUDIT_IP_HASH_SECRET=
STAGING_INTEGRATION_ENCRYPTION_KEYS=
STAGING_CORS_ORIGINS=["https://staging.beanly.example.com"]
STAGING_TRUSTED_HOSTS=["staging.beanly.example.com"]

# A separate staging telemetry project and token are mandatory.
STAGING_OTEL_BACKEND_OTLP_ENDPOINT=
STAGING_OTEL_BACKEND_AUTH_TOKEN=

STAGING_DB_POOL_SIZE=3
STAGING_DB_MAX_OVERFLOW=2
STAGING_DB_PROCESS_COUNT=4
STAGING_DB_ADMIN_RESERVE=10
STAGING_DB_CONNECTION_BUDGET=40
