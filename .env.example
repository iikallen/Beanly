ENVIRONMENT=development
POSTGRES_DB=beanly
POSTGRES_USER=beanly
POSTGRES_PASSWORD=beanly
DATABASE_URL=postgresql+asyncpg://beanly:beanly@postgres:5432/beanly
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=12
# Comma-separated Fernet keys, newest first. This known key is development-only;
# production rejects it and requires keys generated with Fernet.generate_key().
INTEGRATION_ENCRYPTION_KEYS=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
INTEGRATION_HTTP_CONNECT_TIMEOUT_SECONDS=3
INTEGRATION_HTTP_READ_TIMEOUT_SECONDS=10
INTEGRATION_HTTP_MAX_CONNECTIONS=50
INTEGRATION_OAUTH_PUBLIC_BASE_URL=http://localhost:8000
INTEGRATION_JOB_BATCH_SIZE=25
INTEGRATION_JOB_LEASE_SECONDS=60
INTEGRATION_JOB_MAX_ATTEMPTS=10
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://api:8000
FRONTEND_URL=http://localhost:3000
INVITATION_DAYS=7
